# Ruta al volumen o punto de montaje de almacenamiento masivo (ej. HDD secundario)
STORAGE_PATH=/mnt/storage

# Configuración VPN (Gluetun)
# Consulta la documentación oficial de Gluetun para los parámetros requeridos por tu proveedor
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=TU_PRIVATE_KEY_AQUI
WIREGUARD_PRESHARED_KEY=TU_PRESHARED_KEY_AQUI

# Integraciones Unpackerr con Sonarr / Radarr
UN_SONARR_API_KEY=TU_SONARR_API_KEY_AQUI
UN_RADARR_API_KEY=TU_RADARR_API_KEY_AQUI
