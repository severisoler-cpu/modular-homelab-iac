# =============================================================================
# .backup_secrets.example - Plantilla de credenciales para master_backup.sh
# Copia este archivo a .backup_secrets y otorga permisos estrictos (chmod 600)
# =============================================================================

# --- Notificaciones Telegram (Opcional) ---
TG_BOT_TOKEN="TU_BOT_TOKEN_TELEGRAM_AQUI"
TG_CHAT_ID="TU_CHAT_ID_TELEGRAM_AQUI"

# --- Backup de Base de Datos Cloud / Remota (Opcional) ---
REMOTE_DB_HOST="db.tu-proveedor-cloud.com"
REMOTE_DB_PORT="5432"
REMOTE_DB_USER="postgres"
REMOTE_DB_PASSWORD="TU_PASSWORD_AQUI"
REMOTE_DB_NAME="postgres"
