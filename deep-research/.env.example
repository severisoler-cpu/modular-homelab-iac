# =============================================================================
#  deep-research — Plantilla de Configuración (.env.example)
# =============================================================================

# =============================================================================
# OPCIÓN A: MODELOS EN LA NUBE (Recomendado para máxima precisión y rapidez)
# =============================================================================
# 1. Usando OpenAI:
# RETRIEVER=tavily
# TAVILY_API_KEY=tu_tavily_api_key_aqui
# SMART_LLM=openai:gpt-4o
# FAST_LLM=openai:gpt-4o-mini
# OPENAI_API_KEY=tu_openai_api_key_aqui
# EMBEDDING_PROVIDER=openai

# 2. Usando Google Gemini (vía endpoint compatible OpenAI):
RETRIEVER=tavily
TAVILY_API_KEY=TU_API_KEY_TAVILY_AQUI
SMART_LLM=openai:gemini-2.5-flash
FAST_LLM=openai:gemini-2.5-flash
OPENAI_API_KEY=TU_API_KEY_GEMINI_AQUI
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_PROVIDER=google
GOOGLE_API_KEY=TU_API_KEY_GEMINI_AQUI

# =============================================================================
# OPCIÓN B: MODELOS 100% LOCALES Y PRIVADOS (Vía Ollama en nodo GPU / PC)
# =============================================================================
# RETRIEVER=duckduckgo
# SMART_LLM=ollama:deepseek-r1:14b
# FAST_LLM=ollama:llama3.2:3b
# OLLAMA_BASE_URL=http://192.168.1.50:11434
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
